PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/studyflow?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=1h

INITIAL_FACULTY_NAME=StudyFlow Faculty
INITIAL_FACULTY_EMAIL=faculty@example.com
INITIAL_FACULTY_PASSWORD=ChangeThisPassword123!

# Optional AWS S3 configuration for actual study-material file uploads
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
